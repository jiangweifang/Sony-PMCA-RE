+    def test_j1_seed_and_inventory(self):
+        self.assertEqual(m.PRESET, 'CX89700_J1')
+        self.assertEqual(m.SEED_POLICY, 'cx89700_j1')
+        self.assertEqual(m.BACKUP, '0110_backup/SYSIPSX-DSLR/PP/CX89700_J1.bin')
+        expected = {
+            'mode': 0o644,
+            'sha256': 'e02f7bba71d8fe9ecabfd8d0eb8b92cb8046e36d4783a70ad6e7a1c283edc811',
+            'size': 2390264,
+            'source_class': 'sony_original',
+        }
+        self.assertEqual(m.INPUTS[m.BACKUP], (expected['size'], expected['sha256']))
+        inventory = m.trusted_inventory()
+        for name in ('menu-root/seed-backup.bin', 'menu-root/seed-setting/Backup.bin',
+                     'unpacked/firmware.tar_unpacked/' + m.BACKUP):
+            with self.subTest(name=name):
