+    def test_alllang_input_cannot_be_relabelled_j1(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            (root/'analysis').mkdir()
+            inputs = {name: {'source_class': 'sony_original', 'size': size, 'sha256': digest}
+                      for name, (size, digest) in m.INPUTS.items()}
+            inputs[m.BACKUP]['sha256'] = '3dab4f0d6b7790f4a7798034b57f43bfe3255c39dc6da2897fc288b3a218fe47'
+            manifest = {'schema': 2, 'model': 'ILCE-7CM2', 'version': '2.01',
